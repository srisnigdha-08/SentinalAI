# SentinelAI Local Demonstration & Evaluation Profile Template (.env.demo.example)
#
# INSTRUCTIONS:
# 1. Copy this file to deployment/.env.demo:
#    cp deployment/.env.demo.example deployment/.env.demo
# 2. Generate cryptographically strong random secrets for the fields below.
#    You can generate each 32-byte (64-character hex) key using Node.js:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    or OpenSSL:
#      openssl rand -hex 32
#
# NOTE: validateEnv() requires JWT_SECRET, JWT_REFRESH_SECRET, HONEYPOT_API_KEY,
# and SENTINEL_KEY to be distinct, at least 16 characters long, and free from
# generic placeholders ('change_me', 'your_secret', etc.).

PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration & Connection Profiles
# -----------------------------------------------------------------------------
# Profile 1: Local Standalone Development / Viva Evaluation Default (Unauthenticated, Single Node)
# Note: For viva presentation, keep this profile to ensure zero risk to evaluation demo.
MONGO_URI=mongodb://localhost:27017/sentinel-db
MONGO_USE_TRANSACTIONS=false

# Profile 2: Authenticated Least-Privilege Application Profile (Post-Viva Hardened)
# Created via deployment/mongo-init.js (sentinel_app role has find/insert on auditlogs, readWrite on others)
# MONGO_URI=mongodb://sentinel_app:replace_with_strong_app_password@localhost:27017/sentinel-db?authSource=sentinel-db
# MONGO_USE_TRANSACTIONS=false

# Profile 3: Replica Set with Multi-Document Transactions Enabled
# Requires mongod running with --replSet rs0 and rs.initiate()
# MONGO_URI=mongodb://localhost:27017/sentinel-db?replicaSet=rs0
# MONGO_USE_TRANSACTIONS=true

# Profile 4: Production Authenticated Replica Set with Transactions
# MONGO_URI=mongodb://sentinel_app:replace_with_strong_app_password@localhost:27017/sentinel-db?replicaSet=rs0&authSource=sentinel-db
# MONGO_USE_TRANSACTIONS=true

# Dedicated Audit Worker Profile (Insert & Find only on auditlogs):
# MONGO_URI_AUDIT=mongodb://sentinel_audit:replace_with_strong_audit_password@localhost:27017/sentinel-db?authSource=sentinel-db

CLIENT_URL=http://localhost:3000

# Security Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Access token signing key (min 16 chars, 64-char hex recommended)
JWT_SECRET=replace_with_generated_random_jwt_access_secret_64_hex_chars


# Refresh token signing key (must be distinct from JWT_SECRET)
JWT_REFRESH_SECRET=replace_with_generated_random_jwt_refresh_secret_64_hex_chars

# Access tokens last 15 minutes and refresh sessions are managed server-side (authSessionService);
# there is no JWT_EXPIRES_IN / JWT_REFRESH_EXPIRES_IN setting.

# Honeypot ingestion API key (X-API-Key header between honeypots and backend)
HONEYPOT_API_KEY=replace_with_generated_random_honeypot_api_key_64_hex_chars

# Internal AI engine integration key (must be distinct from HONEYPOT_API_KEY)
SENTINEL_KEY=replace_with_generated_random_sentinel_internal_key_64_hex_chars

# Microservice Integrations & Operational Defaults
AI_ENGINE_URL=http://localhost:8000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
LOG_LEVEL=info
ADMIN_EMAIL=admin@sentinel.io
