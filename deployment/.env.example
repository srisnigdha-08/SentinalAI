PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://mongo:27017/sentinel-db

# JWT Configuration (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_access_token_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_hex_32_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Service API Keys (generate with: openssl rand -hex 32)
# HONEYPOT_API_KEY: Authenticates Honeypot ingest events to the Backend
HONEYPOT_API_KEY=CHANGE_ME_honeypot_api_key_min_32_chars
# SENTINEL_KEY: Authenticates internal Sentinel services (AI Engine, Sniffer, Parser)
SENTINEL_KEY=CHANGE_ME_sentinel_internal_key_min_32_chars

AI_ENGINE_URL=http://ai-engine:8000
LOG_LEVEL=info

# Optional: Initial Administrator Provisioning on Database Bootstrap
# If ADMIN_INITIAL_PASSWORD is unset, default admin creation is skipped safely.
ADMIN_EMAIL=admin@sentinel.io
ADMIN_NAME=Admin User
ADMIN_INITIAL_PASSWORD=CHANGE_ME_secure_initial_password_min_8_chars
ADMIN_DEPARTMENT=SOC
