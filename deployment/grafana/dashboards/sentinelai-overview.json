          "mode": "multi"
        }
      },
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Dashboard socket clients",
      "description": "",
      "targets": [
        {
          "expr": "sentinel_socket_clients",
          "legendFormat": "clients",
