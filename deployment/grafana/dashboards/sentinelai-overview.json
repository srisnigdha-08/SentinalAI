      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 20,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "alertlist",
      "title": "Firing SentinelAI alerts",
      "options": {
        "alertInstanceLabelFilter": "",
