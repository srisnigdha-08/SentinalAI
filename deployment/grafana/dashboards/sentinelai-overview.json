        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Predictions by class",
