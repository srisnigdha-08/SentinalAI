      },
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Average inference time",
      "description": "Alert SentinelSlowInference fires above 200 ms",
      "targets": [
        {
          "expr": "rate(sentinel_ai_inference_ms_sum[5m]) / rate(sentinel_ai_inference_count[5m])",
