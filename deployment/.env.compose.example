# Copy to the repository root as .env for `docker compose up`. Generate each secret with: openssl rand -hex 32
# The backend refuses to start with placeholder, short or reused secrets.
SENTINEL_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# Separate secret for AI model hot-reload (engine SENTINEL_ADMIN_KEY / backend AI_ENGINE_ADMIN_KEY)
SENTINEL_ADMIN_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
HONEYPOT_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# First administrator (created only when the account does not exist yet)
ADMIN_EMAIL=admin@sentinel.io
ADMIN_INITIAL_PASSWORD=CHANGE_ME_strong_initial_password

# Optional
ALERT_THRESHOLD=0.90
# Required for the Prometheus profile; also write it to deployment/metrics_token
METRICS_TOKEN=
# Grafana (monitoring profile): write an admin password to deployment/grafana_admin_password (git-ignored).
# Prometheus is on http://127.0.0.1:9090 and Grafana on http://127.0.0.1:3001 (loopback only).
# Published ports (default 127.0.0.1, this machine only). For a honeypot on another host, set the backend
# bind to this host's lab-network IP; the dashboard and API are plain HTTP in this stack.
# BACKEND_BIND_ADDRESS=127.0.0.1
# DASHBOARD_BIND_ADDRESS=127.0.0.1

# Production TLS overlay only (docker-compose.tls.yml); the development stack ignores these.
# TLS_PUBLIC_ORIGIN=https://sentinel.example:8443
# TLS_CERT_DIR=./deployment/tls

# MongoDB authentication (OPS-003): hex values only, e.g. openssl rand -hex 24
MONGO_ROOT_PASSWORD=CHANGE_ME_hex
MONGO_APP_PASSWORD=CHANGE_ME_hex
MONGO_AUDIT_PASSWORD=CHANGE_ME_hex
