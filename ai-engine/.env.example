# SentinelAI AI Engine Configuration Example

# Directory containing serialized models (.pkl) and meta files (.json)
# Default resolves to ai-engine/models. Relative paths are resolved against ai-engine/,
# not the directory you start uvicorn from.
MODEL_DIR=./models

# Node.js Backend API base URL
SENTINEL_API=http://localhost:5000/api

# Internal service authentication key (must match backend SENTINEL_KEY)
SENTINEL_KEY=CHANGE_ME_sentinel_internal_key_min_32_chars

# Alert / threat notification threshold (0.0 to 1.0)
SCORE_THRESHOLD=0.7

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Reinforcement learning Q-table state path (optional)
# Q_TABLE_PATH=./runtime/q_table.json

# By default the Q-learner persists to %LOCALAPPDATA%/SentinelAI/runtime/q_table.json
# (~/.local/share/SentinelAI/... elsewhere), seeded once from models/q_table.json, so learning
# survives restarts. Set to 1 to persist to ai-engine/runtime/ instead. Test runs always use a
# per-process temp file.
# SENTINEL_ALLOW_REPO_RUNTIME_WRITE=1

# Save the Q-table every N learning episodes (default 1; the write is atomic and small)
# Q_SAVE_EVERY=1

# This file is loaded automatically by inference/main.py (already-set variables take precedence).
