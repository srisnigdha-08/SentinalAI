# SentinelAI AI Engine Configuration Example

# Directory containing serialized models (.pkl) and meta files (.json)
# Default resolves to ai-engine/models
MODEL_DIR=./models

# Node.js Backend API base URL
SENTINEL_API=http://localhost:5000/api

# Internal service authentication key (must match backend SENTINEL_KEY)
SENTINEL_KEY=CHANGE_ME_sentinel_internal_key_min_32_chars

# Alert / threat notification threshold (0.0 to 1.0)
SCORE_THRESHOLD=0.7

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Reinforcement learning Q-table state path (optional)
# Q_TABLE_PATH=./runtime/q_table.json
