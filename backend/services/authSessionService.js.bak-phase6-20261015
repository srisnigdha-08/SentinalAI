const crypto = require('crypto')
const jwt = require('jsonwebtoken')
const mongoose = require('mongoose')
const User = require('../models/User')
const AuthSession = require('../models/AuthSession')
const ISSUER = 'sentinelai'
const AUDIENCE = 'sentinelai-browser'
const ACCESS_SECONDS = 900
const REFRESH_SECONDS = 30 * 86400
let socketServer = null
let availability = () => true
function setAvailability(check) {
  availability = check || (() => true)
}
class AuthError extends Error {
  constructor(message = 'Invalid or revoked session', statusCode = 401) {
    super(message)
    this.name = 'AuthError'
    this.statusCode = statusCode
  }
}
const version = (user) => user.authVersion ?? 0
const hash = (value) => crypto.createHash('sha256').update(value).digest('hex')
const same = (a, b) =>
  typeof a === 'string' &&
  typeof b === 'string' &&
  a.length === b.length &&
  crypto.timingSafeEqual(Buffer.from(a), Buffer.from(b))
const sessionRoom = (id) => 'auth-session:' + id
const userRoom = (id) => 'auth-user:' + id
function attachSocketServer(io) {
  socketServer = io
}
function disconnectSession(id) {
  socketServer?.in(sessionRoom(id)).disconnectSockets(true)
}
function disconnectUser(id) {
  socketServer?.in(userRoom(String(id))).disconnectSockets(true)
}
async function store(action) {
  try {
    if (!availability()) throw new AuthError('Authentication service unavailable', 503)
    const result = await action()
    if (!availability()) throw new AuthError('Authentication service unavailable', 503)
    return result
  } catch (error) {
    if (error instanceof AuthError) throw error
    throw new AuthError('Authentication service unavailable', 503)
  }
}
function sign(user, session, purpose) {
  const now = Math.floor(Date.now() / 1000)
  const expiry = Math.floor(new Date(session.expiresAt).getTime() / 1000)
  const payload = {
    id: String(user._id),
    sid: session._id,
    av: version(user),
    purpose,
    jti: crypto.randomBytes(32).toString('hex'),
    iat: now,
    exp: purpose === 'access' ? Math.min(now + ACCESS_SECONDS, expiry) : expiry,
  }
  if (purpose === 'access') payload.role = user.role
  else payload.gen = session.generation
  return jwt.sign(payload, purpose === 'access' ? process.env.JWT_SECRET : process.env.JWT_REFRESH_SECRET, {
    algorithm: 'HS256',
    issuer: ISSUER,
    audience: AUDIENCE,
  })
}
function verifyToken(token, purpose) {
  if (typeof token !== 'string' || token.length > 4096) throw new AuthError('Invalid token')
  let claims
  try {
    claims = jwt.verify(token, purpose === 'access' ? process.env.JWT_SECRET : process.env.JWT_REFRESH_SECRET, {
      algorithms: ['HS256'],
      issuer: ISSUER,
      audience: AUDIENCE,
    })
  } catch {
    throw new AuthError('Invalid or expired token')
  }
  const now = Math.floor(Date.now() / 1000)
  if (
    !claims ||
    typeof claims !== 'object' ||
    claims.purpose !== purpose ||
    typeof claims.id !== 'string' ||
    !mongoose.isValidObjectId(claims.id) ||
    typeof claims.sid !== 'string' ||
    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(claims.sid) ||
    typeof claims.jti !== 'string' ||
    !/^[0-9a-f]{64}$/.test(claims.jti) ||
    !Number.isSafeInteger(claims.av) ||
    claims.av < 0 ||
    !Number.isSafeInteger(claims.iat) ||
    claims.iat > now + 30 ||
    !Number.isSafeInteger(claims.exp) ||
    claims.exp <= claims.iat ||
    claims.exp - claims.iat > (purpose === 'access' ? ACCESS_SECONDS : REFRESH_SECONDS) ||
    (purpose === 'access' && !['admin', 'analyst', 'viewer'].includes(claims.role)) ||
    (purpose === 'refresh' && (!Number.isSafeInteger(claims.gen) || claims.gen < 0))
  )
    throw new AuthError('Invalid token claims')
  return claims
}
async function load(claims) {
  return store(async () => {
    const session = await AuthSession.findById(claims.sid).select('+refreshHash')
    if (
      !session ||
      session.revokedAt ||
      !Number.isFinite(new Date(session.expiresAt).getTime()) ||
      new Date(session.expiresAt).getTime() <= Date.now() ||
      String(session.user) !== claims.id ||
      session.authVersion !== claims.av
    )
      throw new AuthError()
    const user = await User.findById(claims.id).select('-password')
    if (!user) throw new AuthError('User not found')
    if (user.status !== 'active') throw new AuthError('Account inactive', 403)
    if (version(user) !== claims.av) throw new AuthError('Session changed; sign in again')
    return { user, session, claims }
  })
}
async function authorize(token) {
  return load(verifyToken(token, 'access'))
}
async function revokeSession(id, reason = 'logout') {
  await store(() =>
    AuthSession.updateOne({ _id: id, revokedAt: null }, { $set: { revokedAt: new Date(), revocationReason: reason } })
  )
  disconnectSession(id)
}
async function revokeUserSessions(id, reason) {
  // Version updates are the primary revocation boundary even if metadata cleanup fails.
  disconnectUser(id)
  await store(() =>
    AuthSession.updateMany({ user: id, revokedAt: null }, { $set: { revokedAt: new Date(), revocationReason: reason } })
  )
}
async function logoutAll(user) {
  const updated = await store(() => User.findByIdAndUpdate(user._id, { $inc: { authVersion: 1 } }, { new: true }))
  if (!updated) throw new AuthError()
  await revokeUserSessions(user._id, 'logout-all')
}
async function issue(user) {
  if (user.status !== 'active') throw new AuthError('Account inactive', 403)
  const session = {
    _id: crypto.randomUUID(),
    user: user._id,
    authVersion: version(user),
    generation: 0,
    expiresAt: new Date((Math.floor(Date.now() / 1000) + REFRESH_SECONDS) * 1000),
    lastUsedAt: new Date(),
    revokedAt: null,
  }
  const refreshToken = sign(user, session, 'refresh')
  session.refreshHash = hash(refreshToken)
  await store(() => AuthSession.create(session))
  const token = sign(user, session, 'access')
  await authorize(token) // Catch account changes/session revocation racing with creation.
  return { token, refreshToken, user: user.toJSON() }
}
async function rotate(refreshToken) {
  const claims = verifyToken(refreshToken, 'refresh')
  const { user, session } = await load(claims)
  if (claims.exp !== Math.floor(new Date(session.expiresAt).getTime() / 1000)) throw new AuthError()
  if (claims.gen < session.generation) {
    await revokeSession(session._id, 'refresh-replay')
    throw new AuthError('Refresh replay; sign in again')
  }
  if (claims.gen !== session.generation || !same(hash(refreshToken), session.refreshHash)) throw new AuthError()
  const successor = { ...session.toObject(), generation: session.generation + 1 }
  const nextRefresh = sign(user, successor, 'refresh')
  const updated = await store(() =>
    AuthSession.findOneAndUpdate(
      {
        _id: session._id,
        user: user._id,
        authVersion: claims.av,
        generation: claims.gen,
        refreshHash: hash(refreshToken),
        revokedAt: null,
        expiresAt: { $gt: new Date() },
      },
      { $set: { refreshHash: hash(nextRefresh), lastUsedAt: new Date() }, $inc: { generation: 1 } },
      { new: true }
    )
  )
  if (!updated) {
    const current = await store(() => AuthSession.findById(session._id))
    if (current && !current.revokedAt && current.generation > claims.gen)
      await revokeSession(session._id, 'refresh-replay')
    throw new AuthError('Session changed; sign in again')
  }
  const token = sign(user, updated, 'access')
  await authorize(token) // Rotation/logout/password races cannot authorize an orphan token.
  return { token, refreshToken: nextRefresh, user: user.toJSON() }
}
async function logout(refreshToken, accessToken) {
  if (!refreshToken && !accessToken) return
  const claims = verifyToken(refreshToken || accessToken, refreshToken ? 'refresh' : 'access')
  const session = await store(() => AuthSession.findById(claims.sid))
  if (session && String(session.user) === claims.id) await revokeSession(session._id)
}
module.exports = {
  AuthError,
  authorize,
  issue,
  rotate,
  logout,
  logoutAll,
  revokeSession,
  revokeUserSessions,
  verifyToken,
  hash,
  attachSocketServer,
  setAvailability,
  disconnectSession,
  disconnectUser,
  sessionRoom,
  userRoom,
  ACCESS_SECONDS,
  REFRESH_SECONDS,
}
