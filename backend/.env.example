PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/sentinel-db

# JWT Configuration (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32_access_token_secret
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_hex_32_refresh_token_secret
# Access tokens last 15 minutes and refresh sessions are managed server-side (authSessionService);
# there is no JWT_EXPIRES_IN / JWT_REFRESH_EXPIRES_IN setting.

CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Separate per-key budget for internal services (honeypot ingest, AI engine callbacks)
RATE_LIMIT_MACHINE_MAX=20000
# Window for AI analytics aggregates (days, 1-90)
ANALYTICS_WINDOW_DAYS=30
# Close honeypot sessions still "active" after this many hours without activity
HONEYPOT_STALE_SESSION_HOURS=6
# Alerts are deleted by a MongoDB TTL index this many days after creation (1-365)
ALERT_RETENTION_DAYS=7
# MongoDB connection pool size and server-selection timeout (ms)
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# One SYSTEM_HEALTH alert per window while the AI engine is degraded (ms)
DEGRADED_ALERT_COOLDOWN_MS=300000

# Service API Keys (generate with: openssl rand -hex 32)
# HONEYPOT_API_KEY: Authenticates Honeypot ingest events to the Backend
HONEYPOT_API_KEY=CHANGE_ME_honeypot_api_key_min_32_chars
# SENTINEL_KEY: Authenticates internal Sentinel services (AI Engine, Sniffer, Parser)
SENTINEL_KEY=CHANGE_ME_sentinel_internal_key_min_32_chars

AI_ENGINE_URL=http://localhost:8000
LOG_LEVEL=info

# Optional: Initial Administrator Provisioning on Database Bootstrap
# If ADMIN_INITIAL_PASSWORD is unset, default admin creation is skipped safely.
ADMIN_EMAIL=admin@sentinel.io
ADMIN_NAME=Admin User
ADMIN_INITIAL_PASSWORD=CHANGE_ME_secure_initial_password_min_8_chars
ADMIN_DEPARTMENT=SOC
# Containment safety: comma-separated IPv4 hosts/CIDRs that must never be blocked (this host,
# gateway, analyst LAN). Applies to auto-block, manual block and policy containment.
# CONTAINMENT_PROTECTED_TARGETS=192.168.1.1,192.168.1.10

# Deception persona Cowrie actually serves (honeypot/cowrie/cowrie.cfg is CentOS 7). Used as the
# Q-learner action; recommendations are logged, not applied automatically.
# DECEPTION_ACTIVE_PROFILE=centos_7
