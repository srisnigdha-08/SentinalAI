# Dependency folders
node_modules/
.venv/
env/
venv/
ENV/

# Python caching
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local configuration & secrets
.env
.env.*
!.env.example
.env.test
**/.env.test
!.env.demo.example
!deployment/.env.demo.example
!deployment/.env.compose.example

# Logs and runtime artifacts
*.log
logs/
errors.log
sentinel.log

# Build and dist outputs
dist/
build/
.parcel-cache/
.eslintcache

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Native test and learning state
.test-runtime/
runtime/
.native-integration/
coverage/
*.bak*

# Accidental binary artifacts
System.IO.MemoryStream

# Datasets and large PCAP captures
datasets/
ai-engine/datasets/
*.csv
*.pcap
*.pcap_ISCX.csv

# Evidence dumps
scratch/evidence/
backups/



# Playwright Test Artifacts
playwright-report/
test-results/
**/playwright-report/
**/test-results/

# Ad-hoc pre-edit backups (git history keeps prior versions)
*.bak-*
*.orig-*

# Prometheus scrape credential for the compose monitoring profile
deployment/metrics_token
deployment/grafana_admin_password
# TLS certificates and private keys for docker-compose.tls.yml
deployment/tls/

# Candidate model copies written by training/pipeline.py and retrain_from_samples.py; reports stay tracked.
# The served copies live in ai-engine/models/ (registered).
ai-engine/experiments/pipeline/*/models/*.pkl
ai-engine/experiments/retraining/*/*.pkl

# Built by honeypot/build_honeyfs.py (persona fs.pickle files and txtcmds)
honeypot/personas/

# Cross-service integration run evidence (scripts/integration/run_integration.cjs)
scripts/integration/runs/
# Holdout split manifests (~6 MB each; regenerated by ai-engine/evaluation/xgb_holdout_eval.py, sha256 kept in plan.json)
ai-engine/experiments/xgb_holdout_*/manifest_*.json
scripts/perf/runs/
# Local agent settings (launch.json etc.) and ML run console captures: never committed (READINESS_2026-11-02)
.claude/
ai-engine/experiments/*_stdout.txt
